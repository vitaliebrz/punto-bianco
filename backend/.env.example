# Copiază acest fișier în .env și completează valorile (fișierul .env NU se pune pe GitHub).

# Neon -> Connection string POOLED (host-ul conține "-pooler"). Folosit de aplicație.
DATABASE_URL="postgresql://USER:PAROLA@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Neon -> Connection string DIRECT (fără "-pooler"). Folosit doar de prisma migrate.
DIRECT_URL="postgresql://USER:PAROLA@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Cheie secretă pentru semnarea token-urilor JWT (un șir lung, aleator)
JWT_SECRET="schimba-ma-cu-un-sir-lung-si-aleator"

PORT=3000

# Adresa frontend-ului care are voie să cheme API-ul (CORS). Pe Render: adresa de pe Vercel.
FRONTEND_URL="http://localhost:5173"

# Parola comună a conturilor demo create de seed (npm run seed)
SEED_PASSWORD="Demo1234!"
